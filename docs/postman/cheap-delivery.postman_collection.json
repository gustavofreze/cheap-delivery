		{
			"name": "Use cases",
			"item": [
				{
					"name": "Dispatch with the lowest cost",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Records the dispatch and assigns it an identifier', function () {",
									"    pm.response.to.have.status(201);",
									"    const body = pm.response.json();",
									"    pm.expect(body.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);",
									"});",
									"",
									"// The queries below read this dispatch back. A selected environment shadows the collection",
									"// scope, so writing only the collection variable would leave a stale environment entry winning.",
									"const dispatchId = pm.response.json().id;",
									"",
									"pm.collectionVariables.set('dispatchId', dispatchId);",
									"",
									"if (pm.environment.name) {",
									"    pm.environment.set('dispatchId', dispatchId);",
									"}"
								]
							}
						}
					],
