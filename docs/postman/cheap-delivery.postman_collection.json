		{
			"name": "Queries",
			"item": [
				{
					"name": "Find dispatches",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Returns a cursor page', function () {",
									"    pm.response.to.have.status(200);",
									"    const body = pm.response.json();",
									"    pm.expect(body.data).to.be.an('array');",
									"    pm.expect(body.meta).to.have.property('has_next');",
									"    pm.expect(body.links).to.have.property('self');",
									"});",
									"",
									"pm.test('Orders the page most recent first', function () {",
									"    const stamps = pm.response.json().data.map((item) => item.created_at);",
									"    pm.expect(stamps).to.eql([...stamps].sort().reverse());",
									"});",
									"",
									"pm.test('Carries the dispatch that was just recorded', function () {",
									"    const identifiers = pm.response.json().data.map((item) => item.id);",
									"    pm.expect(identifiers).to.include(pm.variables.get('dispatchId'));",
									"});"
								]
							}
						}
					],
