{
	"info": {
		"_postman_id": "0b4b6a1e-7d2f-4f2b-9f4a-1a2d3c4b5e6f",
		"name": "Cheap Delivery",
		"description": "Every operation the service publishes, in the order the collection runner needs them.\n\nThe folders mirror the documentation pages: `Use cases` renders `docs/USE_CASES.md`, `Queries` renders `docs/QUERIES.md`, and `Health` renders `docs/HEALTH.md`. Each request keeps the name of its `operationId` summary in `openapi.yaml`, so a request and its contract are found under the same words.\n\nRunning the whole collection top to bottom works on a fresh stack. `Dispatch with the lowest cost` stores the dispatch identifier it gets back, so the queries that follow address a dispatch that exists.\n\n`baseUrl` is a collection variable, so the collection runs with no environment imported. Import `cheap-delivery-local.postman_environment.json` to point it somewhere else.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://cheap-delivery.localhost:8190",
			"type": "string"
		},
		{
			"key": "dispatchId",
			"value": "",
			"type": "string"
		}
	],
	"event": [
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Runs after every request in the collection.",
					"// A body served under the wrong type is what the endpoints must never do, and asserting the",
					"// parsed body alone never catches it, because Postman parses JSON regardless.",
					"if (pm.response.text()) {",
					"    pm.test('Declares a JSON content type', function () {",
					"        pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
					"    });",
					"}"
				]
			}
		}
	],
